abi <abi/4.0>,
include <tunables/global>
profile ottrin-html-profile-probe /usr/libexec/ottrin/ottrin-html-profile-probe flags=(attach_disconnected) {
  capability,
  userns,
  mount,
  umount,
  pivot_root,
  network,
  unix,
  ptrace,
  signal,
  mqueue,
  io_uring,
  dbus,
  file rwlk /{**,},
  /usr/lib/** mr,
  /lib/** mr,
  /lib64/** mr,
  /usr/libexec/ottrin/html-probe-runtime/** mr,
  /usr/bin/bwrap ix,
  /usr/libexec/ottrin/html-probe-runtime/chrome ix,
  /usr/libexec/ottrin/html-probe-runtime/chrome_crashpad_handler ix,
}
