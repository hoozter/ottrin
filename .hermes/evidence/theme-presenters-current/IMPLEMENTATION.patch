+    fn theme_preview_exposes_the_live_navigation_controls_and_selects_their_role() {
+        use egui::accesskit::{Action, ActionRequest, Role};
+        let mut app = OttrinApp::default();
+        app.state.active_tab_mut().view_mode = ViewMode::Miller;
+        let colors = app.colors;
+        let input = |events| egui::RawInput {
+            screen_rect: Some(Rect::from_min_size(
+                egui::Pos2::ZERO,
+                Vec2::new(1000.0, 700.0),
+            )),
+            events,
+            ..Default::default()
+        };
+        let live_context = Context::default();
+        live_context.enable_accesskit();
+        let live = live_context.run(input(vec![]), |ctx| app.render_nav_row(ctx));
+        let preview_context = Context::default();
+        preview_context.enable_accesskit();
+        let mut selected = None;
+        let mut render = |events| {
+            preview_context.run(input(events), |ctx| {
+                egui::CentralPanel::default().show(ctx, |ui| {
+                    selected =
+                        theme_editor_large_preview(ui, colors, ThemePreviewRegion::Defaults).1;
+                });
+            })
+        };
+        let preview = render(vec![]);
+        let buttons = |output: &egui::FullOutput| {
+            output
+                .platform_output
+                .accesskit_update
+                .as_ref()
+                .unwrap()
+                .nodes
+                .iter()
+                .filter(|(_, node)| node.role() == Role::Button)
+                .map(|(id, node)| {
+                    (
+                        node.label().unwrap_or_default().to_owned(),
+                        (*id, node.bounds().unwrap()),
+                    )
+                })
+                .collect::<std::collections::HashMap<_, _>>()
+        };
+        let live_buttons = buttons(&live);
+        let preview_buttons = buttons(&preview);
+        for name in [
+            "Back",
+            "Forward",
+            "Parent folder",
+            "Menu",
+            "Switch to List view",
+            "View Options",
+        ] {
+            let actual = live_buttons.get(name).expect("Live toolbar control").1;
+            let sample = preview_buttons
+                .get(name)
+                .expect("Preview must use real toolbar widgets")
+                .1;
+            assert!(
+                (actual.width() - sample.width()).abs() < 0.1,
+                "{name}: width"
+            );
+            assert!(
+                (actual.height() - sample.height()).abs() < 0.1,
+                "{name}: height"
+            );
+        }
+        assert!(!preview.shapes.iter().any(|shape| matches!(&shape.shape,egui::Shape::Text(text) if ["Sync","<-","->","^"].contains(&text.galley.job.text.as_str()))));
+        assert!(
+            preview_buttons
+                .keys()
+                .filter(|label| label.starts_with("Open "))
+                .count()
+                >= 3,
+            "Preview must show the production breadcrumb controls"
+        );
+        let target = preview_buttons["Back"].0;
+        let _ = render(vec![egui::Event::AccessKitActionRequest(ActionRequest {
+            action: Action::Click,
+            target,
+            data: None,
+        })]);
+        assert_eq!(selected, Some(ThemePreviewRegion::Navigation));
+    }
