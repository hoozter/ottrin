+// Widget presentation is shared by live navigation and the theme editor.
+// Callers own navigation, menus and filesystem effects.
+fn navigation_buttons(
+    ui: &mut egui::Ui,
+    c: Colors,
+    enabled: [bool; 3],
+) -> Option<PointerNavigation> {
+    let mut action = None;
+    for (index, kind, icon, label, tip, empty_tip) in [
+        (
+            0,
+            PointerNavigation::Back,
+            MI_ARROW_BACK,
+            "Back",
+            "Back to previous folder (Alt+Left)",
+            "Back history is empty. Open another folder first.",
+        ),
+        (
+            1,
+            PointerNavigation::Forward,
+            MI_ARROW_FORWARD,
+            "Forward",
+            "Forward to next folder (Alt+Right)",
+            "Forward history is empty. Use Back first to create forward history.",
+        ),
+        (
+            2,
+            PointerNavigation::Up,
+            MI_ARROW_UP,
+            "Parent folder",
+            "Go to parent folder (Alt+Up)",
+            "This folder has no parent.",
+        ),
+    ] {
+        let color = if enabled[index] {
+            c.text_muted
+        } else {
+            c.text_muted.gamma_multiply(0.62)
+        };
+        if ui
+            .add_enabled(
+                enabled[index],
+                egui::Button::new(RichText::new(icon).size(20.0 * c.font_scale).color(color))
+                    .frame(false)
+                    .min_size(Vec2::splat(30.0))
+                    .themed(&c)
+                    .accessible_name(label),
+            )
+            .on_hover_text(if enabled[index] { tip } else { empty_tip })
+            .clicked()
+        {
+            action = Some(kind);
+        }
+    }
+    action
+}
+
+fn application_menu_button(ui: &mut egui::Ui, c: Colors) -> egui::Response {
+    let response = ui
+        .add(
+            egui::Button::image(
+                egui::Image::new(egui::include_image!("../../../assets/icon.svg"))
+                    .fit_to_exact_size(Vec2::splat(20.0))
+                    .tint(c.text_muted),
+            )
+            .frame(false)
+            .min_size(Vec2::splat(30.0))
+            .themed(&c),
+        )
+        .on_hover_text("Menu");
+    response.widget_info(|| WidgetInfo::labeled(WidgetType::Button, true, "Menu"));
+    if response.hovered() {
+        ui.ctx().set_cursor_icon(egui::CursorIcon::PointingHand);
+    }
+    response
+}
+
+fn view_mode_button(ui: &mut egui::Ui, c: Colors, view: ViewMode) -> egui::Response {
+    let icon = match view {
+        ViewMode::Miller => MI_VIEW_COLUMN,
+        ViewMode::List => MI_VIEW_LIST,
+        ViewMode::Grid => MI_APPS,
+    };
+    let label = view_toggle_accessibility_label(view);
+    let response = ui
+        .add(
+            egui::Button::new(
+                RichText::new(icon)
+                    .size(20.0 * c.font_scale)
+                    .color(c.text_muted),
+            )
+            .frame(false)
+            .min_size(Vec2::splat(30.0))
+            .themed(&c),
+        )
+        .on_hover_text(label);
+    response.widget_info(|| WidgetInfo::labeled(WidgetType::Button, true, label));
+    response
+}
+
+fn view_options_button(ui: &mut egui::Ui, c: Colors) -> egui::Response {
+    let response = ui
+        .add(
+            egui::Button::new(
+                RichText::new(MI_DASHBOARD_CUSTOMIZE)
+                    .size(19.0 * c.font_scale)
+                    .color(c.text_muted),
+            )
+            .frame(false)
+            .min_size(Vec2::splat(30.0))
+            .themed(&c),
+        )
+        .on_hover_text("View Options");
+    response.widget_info(|| WidgetInfo::labeled(WidgetType::Button, true, "View Options"));
+    if response.hovered() {
+        ui.ctx().set_cursor_icon(egui::CursorIcon::PointingHand);
+    }
+    response
+}
+
+struct BreadcrumbResponse {
+    destination: Option<PathBuf>,
+    edit_requested: bool,
+}
+
+fn breadcrumb_bar(
+    ui: &mut egui::Ui,
+    c: Colors,
+    path: &Path,
+    id: egui::Id,
+    colorize_file_types: bool,
+    colorize_folder_labels: bool,
+) -> BreadcrumbResponse {
+    let palette = semantic_palette(&c);
+    let mut destination = None;
+    let mut crumb_right = None;
+    let frame = Frame::new()
+        .fill(c.toolbar_bg)
+        .corner_radius(c.border_radius)
+        .inner_margin(egui::Margin::symmetric(10, 3));
+    let address = frame.show(ui, |ui| {
+        ui.set_width(ui.available_width());
+        ScrollArea::horizontal()
+            .id_salt(id.with(path))
+            .auto_shrink([false, true])
+            .min_scrolled_width(0.0)
+            .scroll_bar_visibility(ScrollBarVisibility::AlwaysHidden)
+            .stick_to_right(true)
+            .show(ui, |ui| {
+                ui.with_layout(Layout::left_to_right(Align::Center), |ui| {
+                    ui.set_height(18.0);
+                    let crumbs = path_crumbs(path);
+                    for (index, crumb) in crumbs.iter().enumerate() {
+                        let icon = if crumb.is_root {
+                            MI_STORAGE
+                        } else {
+                            let semantic = semantic_for_path(&crumb.target);
+                            let style = style_for_semantic(
+                                &semantic,
+                                EntryVisualState::default(),
+                                &c,
+                                &palette,
+                                colorize_file_types,
+                                colorize_folder_labels,
+                            );
+                            material_icon(style.icon)
+                        };
+                        let response = ui.add(
+                            egui::Button::new(
+                                RichText::new(format!("{} {}", icon, crumb.label))
+                                    .color(c.text_muted)
+                                    .size(13.0 * c.font_scale),
+                            )
+                            .frame(false)
+                            .themed(&c)
+                            .accessible_name(format!("Open {}", path_label(&crumb.target))),
+                        );
+                        crumb_right = Some(response.rect.right());
+                        if response.clicked() {
+                            destination = Some(crumb.target.clone());
+                        }
+                        if response.hovered() {
+                            ui.ctx().set_cursor_icon(egui::CursorIcon::PointingHand);
+                        }
+                        if index + 1 < crumbs.len() {
+                            ui.label(
+                                RichText::new("›")
+                                    .color(c.text_muted)
+                                    .size(12.0 * c.font_scale),
+                            );
+                        }
+                    }
+                });
+            });
+    });
+    let rect = address.response.rect;
+    let edit_rect = Rect::from_min_max(
+        egui::pos2(
+            crumb_right.unwrap_or(rect.left()).min(rect.right()),
+            rect.top(),
+        ),
+        rect.max,
+    );
+    let edit = ui.interact(edit_rect, id.with("edit"), Sense::click());
+    if edit.hovered() {
+        ui.ctx().set_cursor_icon(egui::CursorIcon::Text);
+    }
+    BreadcrumbResponse {
+        destination,
+        edit_requested: edit.clicked(),
+    }
+}
