<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Ottrin isolated MSI engine control plain" Manufacturer="Ottrin QA"
      Version="0.1.0" UpgradeCode="BA411056-5887-4806-8D61-8B3021AA48F9" Scope="perUser">
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="OttrinMsiControlPayload-plain">
        <Component Id="ControlPayload" Guid="4144BD46-F6FD-4134-90AF-DF76947C4E3D">
          <File Id="ControlText" Source="control.txt" />
          <RegistryValue Root="HKCU" Key="Software\OttrinMsiControlQA-plain" Name="Installed"
              Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveControlFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature"><ComponentRef Id="ControlPayload" /></Feature>
    <CustomAction Id="FailRemoval" Directory="SystemFolder"
        ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /c exit 1"
        Execute="deferred" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="FailRemoval" Before="RemoveFiles"
          Condition="REMOVE~=&quot;ALL&quot; AND FAILUNINSTALL=1" />
    </InstallExecuteSequence>
  </Package>
</Wix>
