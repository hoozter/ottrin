<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="Ottrin QA Rollback Control Install" Manufacturer="Ottrin QA" Version="1.0.0" UpgradeCode="33849a58-923b-430b-8bae-2d4925c0fdf9" Scope="perUser" Language="1033">
  <MediaTemplate EmbedCab="yes" />
  <StandardDirectory Id="LocalAppDataFolder"><Directory Id="CONTROLFOLDER" Name="OttrinRollbackControlInstall">
   <Component Id="ControlComponent" Guid="610231b9-f53f-4b3c-b459-617823d469ff">
    <File Id="ControlFile" Source="C:\OttrinDesktopQA\control.txt" />
    <RegistryValue Root="HKCU" Key="Software\OttrinQA\RollbackControlInstall" Name="Owned" Type="integer" Value="1" KeyPath="yes" />
    <RemoveFolder Id="ControlFolderCleanup" On="uninstall" />
   </Component>
  </Directory></StandardDirectory>
  <Feature Id="Main" Level="1"><ComponentRef Id="ControlComponent" /></Feature>
  <CustomAction Id="DeliberateFailure" Error="Owned rollback control failed after execution." />
  <InstallExecuteSequence>
   <InstallExecute Sequence="6500" Condition="1" />
   <Custom Action="DeliberateFailure" After="InstallExecute" Condition="OTTRIN_QA_FAIL=1" />
  </InstallExecuteSequence>
 </Package>
</Wix>