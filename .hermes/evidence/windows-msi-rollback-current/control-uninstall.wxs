<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="Ottrin QA Rollback Control Uninstall" Manufacturer="Ottrin QA" Version="1.0.0" UpgradeCode="7e46c6a4-35f7-4733-84f3-e0e79ef10488" Scope="perUser" Language="1033">
  <MediaTemplate EmbedCab="yes" />
  <StandardDirectory Id="LocalAppDataFolder"><Directory Id="CONTROLFOLDER" Name="OttrinRollbackControlUninstall">
   <Component Id="ControlComponent" Guid="f8550a14-5545-4032-a644-7d814d32da3b">
    <File Id="ControlFile" Source="C:\OttrinDesktopQA\control.txt" />
    <RegistryValue Root="HKCU" Key="Software\OttrinQA\RollbackControlUninstall" Name="Owned" Type="integer" Value="1" KeyPath="yes" />
    <RemoveFolder Id="ControlFolderCleanup" On="uninstall" />
   </Component>
  </Directory></StandardDirectory>
  <Feature Id="Main" Level="1"><ComponentRef Id="ControlComponent" /></Feature>
  <CustomAction Id="DeliberateFailure" Error="Owned rollback control failed after execution." />
  <InstallExecuteSequence>
   <InstallExecute Sequence="6500" Condition="1" />
   <Custom Action="DeliberateFailure" After="InstallExecute" Condition="OTTRIN_QA_FAIL=1" />
  </InstallExecuteSequence>
 </Package>
</Wix>