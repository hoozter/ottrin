<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="Ottrin Hosted Rollback Control uninstall" Manufacturer="Ottrin QA" Version="1.0.0" UpgradeCode="27b60b64-534c-461f-8751-0ad1514be6bb" Scope="perUser" Language="1033">
  <MediaTemplate EmbedCab="yes" />
  <StandardDirectory Id="LocalAppDataFolder"><Directory Id="CONTROLFOLDER" Name="OttrinHostedRollback-uninstall">
   <Component Id="ControlComponent" Guid="a57d5d74-d044-4308-8ed5-57e8800ba176">
    <File Id="ControlFile" Source="$(var.Payload)" />
    <RegistryValue Root="HKCU" Key="Software\OttrinQA\HostedRollback\d94bcc6723a543f7b31bd3c5ad032994\uninstall" Name="Owned" Type="integer" Value="1" KeyPath="yes" />
    <RemoveFolder Id="ControlFolderCleanup" On="uninstall" />
   </Component>
  </Directory></StandardDirectory>
  <Feature Id="Main" Level="1"><ComponentRef Id="ControlComponent" /></Feature>
  <CustomAction Id="DeliberateFailure" Error="Owned rollback control failed after execution." />
  <InstallExecuteSequence>
   <InstallExecute Sequence="6500" Condition="1" />
   <Custom Action="DeliberateFailure" After="InstallExecute" Condition="OTTRIN_QA_FAIL=1" />
  </InstallExecuteSequence>
 </Package>
</Wix>
