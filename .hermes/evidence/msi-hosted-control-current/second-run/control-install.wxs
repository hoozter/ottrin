<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
 <Package Name="Ottrin Hosted Rollback Control install" Manufacturer="Ottrin QA" Version="1.0.0" UpgradeCode="69d7081d-9135-429f-8422-8557d7b8c955" Scope="perUser" Language="1033">
  <MediaTemplate EmbedCab="yes" />
  <StandardDirectory Id="LocalAppDataFolder"><Directory Id="CONTROLFOLDER" Name="OttrinHostedRollback-install">
   <Component Id="ControlComponent" Guid="c862efd1-bae7-4cf7-add0-44f4bd92db20">
    <File Id="ControlFile" Source="$(var.Payload)" />
    <RegistryValue Root="HKCU" Key="Software\OttrinQA\HostedRollback\d94bcc6723a543f7b31bd3c5ad032994\install" Name="Owned" Type="integer" Value="1" KeyPath="yes" />
    <RemoveFolder Id="ControlFolderCleanup" On="uninstall" />
   </Component>
  </Directory></StandardDirectory>
  <Feature Id="Main" Level="1"><ComponentRef Id="ControlComponent" /></Feature>
  <CustomAction Id="DeliberateFailure" Error="Owned rollback control failed after execution." />
  <InstallExecuteSequence>
   <InstallExecute Sequence="6500" Condition="1" />
   <Custom Action="DeliberateFailure" After="InstallExecute" Condition="OTTRIN_QA_FAIL=1" />
  </InstallExecuteSequence>
 </Package>
</Wix>
