# Fixed-protocol, unprivileged HTML entry; never grant this transition to generic bwrap.
abi <abi/4.0>,
include <tunables/global>
profile ottrin-html-render /usr/libexec/ottrin/ottrin-html-render flags=(attach_disconnected) {
  capability,
  userns,
  mount,
  umount,
  pivot_root,
  network,
  unix,
  ptrace,
  signal,
  mqueue,
  io_uring,
  dbus,
  file rwlk /{**,},
  /usr/lib/** mr,
  /usr/lib64/** mr,
  /lib/** mr,
  /lib64/** mr,
  /opt/google/chrome/** mr,
  /usr/libexec/ottrin/ottrin-html-render mr,
  /usr/bin/bwrap ix,
  /opt/google/chrome/chrome ix,
  /usr/lib/chromium/chromium ix,
  /usr/lib/chromium-browser/chromium-browser ix,
  /usr/lib64/chromium-browser/chromium-browser ix,
  /usr/lib64/chromium-browser/chrome_crashpad_handler ix,
  /opt/google/chrome/chrome_crashpad_handler ix,
  /usr/lib/chromium/chrome_crashpad_handler ix,
  /usr/lib/chromium/chromium_crashpad_handler ix,
  /usr/lib/chromium-browser/chrome_crashpad_handler ix,
}
