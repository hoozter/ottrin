<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Ottrin"
      Manufacturer="hoozter"
      Version="$(var.Version)"
      UpgradeCode="04304CE2-990E-4053-9EDA-AF3E69548C9D"
      Scope="perUser">
    <SummaryInformation Description="Ottrin file manager" />
    <!-- Retain the installed product until the replacement payload executes.
         Stable component identities let Windows Installer retain shared files. -->
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="A newer version of Ottrin is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="OttrinApp.ico" SourceFile="$(var.Stage)/assets/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="OttrinApp.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Ottrin">
          <Directory Id="BinFolder" Name="bin" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OttrinProgramMenuFolder" Name="Ottrin" />
    </StandardDirectory>

    <Component Id="StartMenuComponent" Directory="OttrinProgramMenuFolder" Guid="*">
      <Shortcut Id="ApplicationShortcut" Name="Ottrin"
          Target="[#MainExecutable]" WorkingDirectory="BinFolder"
          Icon="OttrinApp.ico" IconIndex="0" />
      <Shortcut Id="UninstallShortcut" Name="Uninstall Ottrin"
          Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]"
          WorkingDirectory="System64Folder" Icon="OttrinApp.ico" IconIndex="0" />
      <RemoveFolder Id="RemoveOttrinProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Ottrin\MSI" Name="StartMenuInstalled"
          Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="MainExecutableComponent" Directory="BinFolder" Guid="*">
      <File Id="MainExecutable" Source="$(var.Stage)/bin/ottrin.exe" KeyPath="yes" />
    </Component>

    <Component Id="IndexTransactionComponent" Directory="BinFolder" Guid="*">
      <File Id="IndexTransactionScript" Source="$(sys.SOURCEFILEDIR)index-task-transaction.ps1" KeyPath="yes" />
      <File Id="IndexIdentityScript" Source="$(sys.SOURCEFILEDIR)windows-index-identity.ps1" />
    </Component>

    <ComponentGroup Id="PortablePayload" Directory="INSTALLFOLDER">
      <Files Include="$(var.Stage)/**/*">
        <Exclude Files="$(var.Stage)/bin/ottrin.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Ottrin" Level="1">
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="IndexTransactionComponent" />
      <ComponentRef Id="StartMenuComponent" />
      <ComponentGroupRef Id="PortablePayload" />
    </Feature>

    <CustomAction Id="RollbackBackgroundIndex" Directory="System64Folder"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IndexTransactionScript]&quot; -Phase Rollback -Snapshot &quot;[TempFolder]OttrinIndexRollback-[ProductCode].json&quot;"
        Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="SnapshotBackgroundIndex" Directory="System64Folder"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IndexTransactionScript]&quot; -Phase Snapshot -Snapshot &quot;[TempFolder]OttrinIndexRollback-[ProductCode].json&quot;"
        Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="CommitBackgroundIndex" Directory="System64Folder"
        ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#IndexTransactionScript]&quot; -Phase Commit -Snapshot &quot;[TempFolder]OttrinIndexRollback-[ProductCode].json&quot;"
        Execute="commit" Impersonate="yes" Return="check" />

    <CustomAction
        Id="InstallBackgroundIndex"
        FileRef="MainExecutable"
        ExeCommand="index service-install"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />
    <CustomAction
        Id="CleanupBeforeUninstall"
        FileRef="MainExecutable"
        ExeCommand="--uninstall"
        Execute="deferred"
        Impersonate="yes"
        Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RollbackBackgroundIndex" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="SnapshotBackgroundIndex" After="RollbackBackgroundIndex" Condition="NOT REMOVE" />
      <Custom Action="InstallBackgroundIndex" After="SnapshotBackgroundIndex" Condition="NOT REMOVE" />
      <Custom Action="CommitBackgroundIndex" After="InstallBackgroundIndex" Condition="NOT REMOVE" />
      <Custom Action="CleanupBeforeUninstall" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
